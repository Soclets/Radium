struct reading:
    time: int[min: 0, max: 86_399];
    celsius: int[min: -40, max: 125];
end struct reading

fn warm [$r: Lent.mut reading] -> void:
    $r.celsius = 1;
    return void;
end fn warm

fn.main [] -> void:
    var.immut $r: reading = reading[time = 3600, celsius = 21];
    warm(Lend.mut $r); // here
    return void;
end fn.main
