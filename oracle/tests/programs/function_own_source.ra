// trace D136
// trace D138
// expect: runs
// output: 20
struct reading:
    time: int[min: 0, max: 86_399];
    celsius: int[min: -40, max: 125];
end struct reading

struct view <`text`>:
    shown: Lend from `text` reading;
end struct view

fn shown_celsius <`t`> [$v: view<`text`: `t`>] -> int[min: -40, max: 125]:
    return $v.shown.celsius;
end fn shown_celsius

fn.main [] -> void:
    var $r: reading = reading[time = 0, celsius = 20];
    var $w: view<`text`: $r> = view[shown = Lend $r];
    std::print(shown_celsius(Lend $w), newline);
    return void;
end fn.main
