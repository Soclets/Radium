// trace D95
// trace D53
// expect: runs
// output: 8
// output: 9
fn double [$n: int[min: 0, max: 9]] -> int[min: 0, max: 18]:
    ensures result equal $n x 2;
    return $n x 2;
end fn double

fn.main [] -> void:
    var $answer = double(4);
    std::print($answer, newline);
    std::print(double(4) + 1, newline);
    return void;
end fn.main
