struct reading:
    time: int[min: 0, max: 86_399];
    celsius: int[min: -40, max: 125];
end struct reading

fn both [$a: Lent.mut reading, $b: Lent.mut reading] -> void:
    $a.celsius = 1;
    $b.celsius = 2;
    return void;
end fn both

fn.main [] -> void:
    var $r: reading = reading[time = 3600, celsius = 21];
    both(Lend.mut $r, Lend.mut $r); // here
