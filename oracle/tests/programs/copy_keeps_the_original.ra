// trace D80
// expect: runs
// output: 3600
struct reading:
    time: int[min: 0, max: 86_399];
    celsius: int[min: -40, max: 125];
end struct reading

fn keep [$r: Given reading] -> void:
    return void;
end fn keep

fn.main [] -> void:
    var $r: reading = reading[time = 3600, celsius = 21];
    keep(Copy $r);
    std::print($r.time, newline);
    return void;
end fn.main
