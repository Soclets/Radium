// trace D95
// trace D53
// expect: runs
// output: 120
fn factorial [$n: int[min: 0, max: 10]] -> int[min: 1, max: 3628800]:
    if $n equal 0:
        return 1;
    end if
    return $n x factorial($n - 1);
end fn factorial

fn.main [] -> void:
    std::print(factorial(5), newline);
    return void;
end fn.main
