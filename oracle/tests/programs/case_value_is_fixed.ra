// trace D72
// expect: refused at line 17
union.tagged status:
    ok;
    warming_up;
    failed[code: int[min: 1, max: 255]];
end union.tagged status

fn.main [] -> void:
    var $s: status = status.failed[code = 3];
    match $s:
        case status.ok:
            std::print("a", newline);
        case status.warming_up:
            std::print("b", newline);
        case status.failed[code = $c]:
            $c = 4; // here
    end match
    return void;
end fn.main
