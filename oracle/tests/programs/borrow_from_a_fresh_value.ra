struct reading:
    time: int[min: 0, max: 86_399];
    celsius: int[min: -40, max: 125];
end struct reading

fn warmer [$a: reading, $b: reading] -> Lend from <$a, $b> reading:
    if $a.celsius > $b.celsius:
        return Lend $a;
    end if
    return Lend $b;
end fn warmer

fn.main [] -> void:
    var $x: reading = reading[time = 0, celsius = 20];
    var $w: Lend from <$x> reading = warmer(Lend $x, reading[time = 1, celsius = 30]); // here
    return void;
end fn.main
