// trace D50
// trace D53
// expect: runs
// output: 4 of 10
fn show_share [$part: int[min: 0, max: 100], $whole: int[min: 1, max: 100]] -> void:
    requires $part at_most $whole;
    std::print($part, " of ", $whole, newline);
    return void;
end fn show_share

fn.main [] -> void:
    show_share(4, 10);
    return void;
end fn.main
